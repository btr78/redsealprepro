# Gmail (or any SMTP account) used to relay texts through carrier
# email-to-SMS gateways. Recommended: a dedicated free Gmail account just
# for this bot, so nothing personal is exposed if a recipient replies.
# Requires 2-Step Verification enabled, then an App Password from
# myaccount.google.com/apppasswords (a regular Gmail password won't work).
SMTP_EMAIL=yourbotaccount@gmail.com
SMTP_APP_PASSWORD=xxxxxxxxxxxxxxxx
# Only needed if not using Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Optional: Telegram failure alerts (Bryan only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=7202311083
